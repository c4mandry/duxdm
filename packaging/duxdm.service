[Unit]
Description=duxdm — simple TUI display manager
Documentation=https://github.com/c4mandry/duxdm
After=systemd-user-sessions.service plymouth-quit-wait.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
ExecStart=/usr/bin/duxdm
Restart=always
RestartSec=2
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=tty
StandardError=tty
Type=idle

[Install]
Alias=display-manager.service
WantedBy=multi-user.target
